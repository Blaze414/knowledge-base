# @tanstack/zod-adapter@1.167.0 declares zod ^3 as a peer dependency but
# works fine with zod 4 (verified in this project). Bun is permissive
# about peers; npm 7+ enforces them strictly. Setting legacy-peer-deps
# lets `npm install` succeed without requiring contributors to pass
# `--legacy-peer-deps` manually.
legacy-peer-deps=true